# ---- LLM providers ----------------------------------------------------------
# Providers: openai | groq (GroqCloud, gsk_ keys) | grok (xAI, xai- keys) | custom (any OpenAI-compatible URL)
# | mock (offline UI testing only)
# Text routes (digital PDFs, OCR text) use LLM_PROVIDER; page-image routes use LLM_VISION_PROVIDER.
LLM_PROVIDER=openai
# Leave empty to use the same provider for images. Example: groq for text, openai for images.
LLM_VISION_PROVIDER=
# Optional: if the provider above fails (timeout, 429, 5xx, bad key), the same request is retried here.
LLM_FALLBACK_PROVIDER=

# One key per provider (only the providers you use need a key). Never commit them.
OPENAI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
# For LLM_PROVIDER=custom:
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=

# Models. Empty = the provider's defaults (text / images):
#   openai: gpt-4.1-mini / gpt-4.1-mini
#   groq:   openai/gpt-oss-120b / qwen/qwen3.8-27b (Groq allows at most 3 images per request)
#   grok:   grok-4-1-fast-reasoning / grok-4-1-fast-reasoning
LLM_MODEL=
LLM_VISION_MODEL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_VISION_MODEL=

# Optional overrides for the primary provider: LLM_API_KEY beats the provider key, LLM_BASE_URL its URL.
LLM_API_KEY=
LLM_BASE_URL=

LLM_TIMEOUT_S=90
# HTTP-level retries per provider (timeouts, 429, 5xx) before falling back
LLM_MAX_API_RETRIES=2
# json_schema | json_object | none (automatically downgraded once if a provider rejects it)
LLM_RESPONSE_FORMAT=json_schema
# Dropped automatically if a model rejects it
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=4096
# max_tokens | max_completion_tokens (switched automatically if rejected)
LLM_MAX_TOKENS_PARAM=max_tokens
LLM_IMAGE_DETAIL=high

# ---- Pricing (USD per 1M tokens). The default models above have built-in rates;
# PRICE_* is used for any other model. Check the provider's current price list.
PRICE_INPUT_PER_1M=0.40
PRICE_CACHED_INPUT_PER_1M=0.10
PRICE_OUTPUT_PER_1M=1.60
# Per-model rates (override built-ins / add new models):
# MODEL_PRICING_JSON={"your-model-id":{"input":1.00,"cached_input":0.25,"output":2.00}}

# ---- Routing ----------------------------------------------------------------
# auto | ocr_first | vision_always | text_only
ROUTING_MODE=auto
OCR_LANG=eng
OCR_DPI=300
MAX_VISION_PAGES=3
# fallback for numeric dates the model didn't normalise
DATE_DAY_FIRST=true

# ---- Validation / review ---------------------------------------------------------
MATH_ABS_TOLERANCE=0.05
MATH_PER_LINE_TOLERANCE=0.01
VALIDATION_RETRY=true
REVIEW_ON_LOW_OCR=true
OCR_REVIEW_MIN_CONFIDENCE=50

# ---- Server / security ---------------------------------------------------------
AUTH_ENABLED=true
# required: the password for the web app
APP_PASSWORD=
# required: long random string (python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=
TOKEN_TTL_HOURS=12
# empty = same-origin only (the SPA is served by the API)
CORS_ORIGINS=
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=10
MAX_CONCURRENT_EXTRACTIONS=2

# ---- Cache / budget --------------------------------------------------------------
CACHE_ENABLED=true
# evaluation / extract-all stop calling the LLM past this
EVAL_BUDGET_USD=2.00
